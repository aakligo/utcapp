{
  "agent": {
    "region": "us-east-1",
    "run_as_user": "root"
  },
  "logs": {
    "logs_collected": {
      "files": {
        "collect_list": [
          {
            "file_path": "/var/log/utc-userdata.log",
            "log_group_name": "/utc-app/dev/application",
            "log_stream_name": "{instance_id}/userdata"
          },
  {
    "file_path": "/var/log/utc-app.log",
    "log_group_name": "/utc-app/dev/application",
    "log_stream_name": "{instance_id}/app",
    "retention_in_days": 7
  }
        ]
      }
    }
  }
}
